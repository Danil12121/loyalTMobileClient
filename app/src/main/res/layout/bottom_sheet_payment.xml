<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvBsPartnerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Название партнера"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBsLoyaltyStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="У вас: 3 из 5 кружек кофе"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvBsPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="К оплате: 250 ₽"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnPay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#FFE338"
        android:textColor="#000"
        android:text="Оплатить" />
</LinearLayout>